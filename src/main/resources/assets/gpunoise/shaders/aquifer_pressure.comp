#version 450
layout(local_size_x = 64) in;

// 32-byte host record: y, fluid levels A/B, fluid kinds A/B, barrier noise,
// followed by two reserved words for the versioned aquifer input contract.
struct PressureInput {
    int y;
    int levelA;
    int levelB;
    uint kindA;
    uint kindB;
    float barrier;
    uint reserved0;
    uint reserved1;
};

layout(std430, set = 0, binding = 0) readonly buffer Inputs { PressureInput items[]; };
layout(std430, set = 0, binding = 1) writeonly buffer Pressures { float values[]; };
layout(push_constant) uniform Parameters { uint count; };

const uint WATER = 1u;
const uint LAVA = 2u;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= count) return;

    PressureInput record = items[i];
    if ((record.kindA == WATER && record.kindB == LAVA)
            || (record.kindA == LAVA && record.kindB == WATER)) {
        values[i] = 2.0;
        return;
    }

    int levelDistance = abs(record.levelA - record.levelB);
    if (levelDistance == 0) {
        values[i] = 0.0;
        return;
    }

    float midpointDelta = (float(record.y) + 0.5)
            - 0.5 * float(record.levelA + record.levelB);
    float halfDistance = 0.5 * float(levelDistance);
    float adjustment = halfDistance - abs(midpointDelta);
    if (midpointDelta > 0.0) {
        adjustment = adjustment > 0.0 ? adjustment / 1.5 : adjustment / 2.5;
    } else {
        float shifted = 3.0 + adjustment;
        adjustment = shifted > 0.0 ? shifted / 3.0 : shifted / 10.0;
    }

    float barrier = adjustment < -2.0 || adjustment > 2.0 ? 0.0 : record.barrier;
    values[i] = 2.0 * (barrier + adjustment);
}
