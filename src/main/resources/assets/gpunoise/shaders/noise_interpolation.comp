#version 450
layout(local_size_x = 64) in;

// Corners are read from the shared terrain lattice. Grid samples are ordered
// Z-fastest, then X, then Y; root values are interleaved within each sample.
layout(std430,set=0,binding=0) readonly buffer Corners { float corners[]; };
layout(std430,set=0,binding=1) writeonly buffer Blocks { float blocks[]; };
// Per chunk: corner offset, block offset, cellsX, cellsY, cellsZ,
// blocksPerCellX, blocksPerCellY, reserved. Horizontal X/Z spacing is shared.
layout(std430,set=0,binding=2) readonly buffer Chunks { uint metadata[]; };
layout(push_constant) uniform Parameters {
    uint chunkCount;
    uint blocksPerChunk;
    uint rootStride;
    uint outputStride;
};

float lerp3(float c000,float c100,float c010,float c110,float c001,float c101,float c011,float c111,vec3 t){
    float x00=mix(c000,c100,t.x), x10=mix(c010,c110,t.x);
    float x01=mix(c001,c101,t.x), x11=mix(c011,c111,t.x);
    return mix(mix(x00,x10,t.z),mix(x01,x11,t.z),t.y);
}

void main(){
    uint globalIndex=gl_GlobalInvocationID.x;
    if(globalIndex>=chunkCount*blocksPerChunk)return;
    uint chunk=globalIndex/blocksPerChunk;
    uint index=globalIndex%blocksPerChunk;
    uint base=chunk*8u;
    uint cornerOffset=metadata[base+0u];
    uint blockOffset=metadata[base+1u];
    uint cellsX=metadata[base+2u], cellsY=metadata[base+3u], cellsZ=metadata[base+4u];
    uint blocksPerCellX=metadata[base+5u];
    uint blocksPerCellY=metadata[base+6u];
    uint blocksX=cellsX*blocksPerCellX;
    uint blocksZ=cellsZ*blocksPerCellX;
    uint perLayer=blocksX*blocksZ;
    uint y=index/perLayer;
    uint rem=index%perLayer;
    uint z=rem/blocksX;
    uint x=rem%blocksX;
    uint cellX=x/blocksPerCellX, cellY=y/blocksPerCellY, cellZ=z/blocksPerCellX;
    vec3 t=vec3(x%blocksPerCellX,y%blocksPerCellY,z%blocksPerCellX)
        /vec3(float(blocksPerCellX),float(blocksPerCellY),float(blocksPerCellX));
    uint gridX=cellsX+1u, gridZ=cellsZ+1u;
    uint cellSample=cornerOffset+((cellY*gridZ+cellZ)*gridX+cellX);
    uint strideX=gridZ*rootStride;
    uint strideY=gridX*gridZ*rootStride;
    uint strideZ=rootStride;
    for(uint root=0u;root<outputStride;root++) {
        uint valueBase=cellSample*rootStride+root;
        float value=lerp3(corners[valueBase],corners[valueBase+strideX],
            corners[valueBase+strideY],corners[valueBase+strideY+strideX],
            corners[valueBase+strideZ],corners[valueBase+strideZ+strideX],
            corners[valueBase+strideY+strideZ],corners[valueBase+strideY+strideZ+strideX],t);
        blocks[blockOffset+index*outputStride+root]=value;
    }
}
