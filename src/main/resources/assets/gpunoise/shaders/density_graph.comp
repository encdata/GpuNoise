    if(x < -0.5) return 0.75; if(x < 0.0) return 1.0; return x < 0.5 ? 1.5 : 2.0;
}
double graphAdd(double x, double y){
#ifdef FAST_MATH
    return double(float(x)+float(y));
#else
    return x+y;
#endif
}
double graphSubtract(double x, double y){
#ifdef FAST_MATH
    return double(float(x)-float(y));
#else
    return x-y;
#endif
}
double graphMultiply(double x, double y){
#ifdef FAST_MATH
    float left=float(x),right=float(y),result=left*right;
    if(result==0.0){uint sign=(floatBitsToUint(left)^floatBitsToUint(right))&0x80000000u;return double(uintBitsToFloat(sign));}
    return double(result);
#else
    double result=x*y;
    if(result==0.0){bool negative=negativeDouble(x)!=negativeDouble(y);return signedZero64(negative);}
    return result;
#endif
}
double graphDivide(double x, double y){
#ifdef FAST_MATH
    float left=float(x),right=float(y);
    bool invalid=isnan(left)||isnan(right)||(left==0.0&&right==0.0)||(isinf(left)&&isinf(right));
    if(invalid)return double(uintBitsToFloat(0x7fc00000u));
    bool negative=negativeFloat(left)!=negativeFloat(right);
    if(right==0.0||isinf(left))return double(uintBitsToFloat((negative?0x80000000u:0u)|0x7f800000u));
    if(isinf(right))return double(signedZero32(negative));
    float result=left/right;
    if(result==0.0)result=signedZero32(negative);
    return double(result);
#else
    bool invalid=isnan(x)||isnan(y)||(x==0.0&&y==0.0)||(isinf(x)&&isinf(y));
    if(invalid)return canonicalNaN64();
    bool negative=negativeDouble(x)!=negativeDouble(y);
    if(y==0.0||isinf(x))return signedInfinity64(negative);
    if(isinf(y))return signedZero64(negative);
    return x/y;
#endif
}
double densityGradient(double from, double to, double t){
#ifdef FAST_MATH
    return graphAdd(from, graphMultiply(graphSubtract(to, from), t));
#else
    return mix(from, to, t);
#endif
}
double mappedTanh(double x){
    float value=float(x);
    if(value>10.0)return 1.0;
    if(value< -10.0)return -1.0;
    float exponential=exp(2.0*value);
    return double((exponential-1.0)/(exponential+1.0));
}
double mapValue(double x,uint op){
    if(op==5u)return abs(x); if(op==6u)return graphMultiply(x,x); if(op==7u)return graphMultiply(graphMultiply(x,x),x);
    if(op==8u)return x>0?x:graphMultiply(x,.5); if(op==9u)return x>0?x:graphMultiply(x,.25);
    if(op==10u){double v=clamp(x,-1.0,1.0);return graphSubtract(graphMultiply(v,.5),graphDivide(graphMultiply(graphMultiply(v,v),v),24.));}
    if(op==11u)return floor(x); if(op==12u)return ceil(x);
    if(op==13u)return sqrt(x); if(op==14u)return double(sin(float(x)));
    if(op==15u)return double(cos(float(x))); if(op==16u)return double(exp(float(x)));
    if(op==17u)return double(log(float(x)));
