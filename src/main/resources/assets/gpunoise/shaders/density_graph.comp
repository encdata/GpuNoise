float spaghettiRarity(float x, uint mapper){
    if(mapper==1u){if(x < -0.75) return 0.5; if(x < -0.5) return 0.75; if(x < 0.5) return 1.0; return x < 0.75 ? 2.0 : 3.0;}
    if(x < -0.5) return 0.75; if(x < 0.0) return 1.0; return x < 0.5 ? 1.5 : 2.0;
}
double mapValue(double x,uint op){
