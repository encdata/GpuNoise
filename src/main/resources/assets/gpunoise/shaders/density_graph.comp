    if(op==20u)return double(mthSinValues[uint(int(float(x)*10430.378+16384.0)&65535)]);
    if(op==21u)return double(sqrt(float(x)));
    if(op==18u){
        float value=float(x);
        if(value>10.0)return 1.0;
        if(value< -10.0)return -1.0;
        float exponential=exp(2.0*value);
        return double((exponential-1.0)/(exponential+1.0));
    }
    return x;
}
bool compareValues(double x,double y,uint mode){
    if(mode>=17u&&mode<=40u){
        double c;
        bool greaterOnNaN=(mode>=23u&&mode<=28u)||mode>=35u;
        if(isnan(x)||isnan(y)) c=greaterOnNaN?1.0:-1.0;
        else c=x<y?-1.0:(x>y?1.0:0.0);
        uint relation=mode<=22u?mode-16u:(mode<=28u?mode-22u:(mode<=34u?mode-28u:mode-34u));
        if(relation==1u)return c==0.0;
        if(relation==2u)return c!=0.0;
        if(relation==3u)return c<0.0;
        if(relation==4u)return c<=0.0;
        if(relation==5u)return c>0.0;
        return c>=0.0;
    }
    if(mode==11u)return x==y;
    if(mode==12u)return x!=y;
    if(mode==13u)return x<y;
    if(mode==14u)return x<=y;
    if(mode==15u)return x>y;
    return x>=y;
}
double splineValue(double coordinate, uint base, uint count, double values[REGISTER_COUNT]) {
    if (count == 0u) return 0.0;
    SplinePoint first = splinePoints[base];
    SplinePoint last = splinePoints[base + count - 1u];
    double firstValue = values[first.valueNode];
    double lastValue = values[last.valueNode];
    if (coordinate < first.location) return firstValue + first.derivative * (coordinate - first.location);
    if (coordinate >= last.location) return lastValue + last.derivative * (coordinate - last.location);
    uint interval = 0u;
    for (uint i = 0u; i + 1u < count; i++) {
        if (coordinate < splinePoints[base + i + 1u].location) { interval = i; break; }
    }
    SplinePoint a = splinePoints[base + interval];
    SplinePoint b = splinePoints[base + interval + 1u];
    double t = (coordinate - double(a.location)) / double(b.location - a.location);
    double va = values[a.valueNode];
    double vb = values[b.valueNode];
    double delta = vb - va;
    double c = double(a.derivative) * double(b.location - a.location) - delta;
    double d = -double(b.derivative) * double(b.location - a.location) + delta;
    return mix(va, vb, t) + t * (1.0 - t) * mix(c, d, t);
}
