        else if(op==20u){v=n.meta.x==0u?pExact.x:(n.meta.x==1u?pExact.y:pExact.z);}
        else if(op==21u){double x=values[n.ids.y],y=values[n.ids.z];if(n.meta.x==1u)v=x+y;else if(n.meta.x==2u)v=x-y;else if(n.meta.x==3u)v=x*y;else if(n.meta.x==4u)v=x/y;else if(n.meta.x==5u)v=min(x,y);else if(n.meta.x==7u)v=javaRemainder(x,y);else if(n.meta.x==8u)v=double(atan(float(x),float(y)));else if(n.meta.x==9u)v=javaPow(x,y);else v=max(x,y);}
        else if(op==22u)v=compareValues(values[n.ids.y],values[n.ids.z],n.meta.x)?1.0:0.0;
        else if(op==23u)v=values[n.ids.y]!=0.0?values[n.ids.z]:values[n.ids.w];
        else if(op==24u)v=javaIntOperation(n.meta.x,values[n.ids.y],n.meta.x==6u?0.0:values[n.ids.z]);
        else if(op==25u)v=javaFloatOperation(n.meta.x,values[n.ids.y],n.meta.x==6u?0.0:values[n.ids.z]);
        else if(op==26u)v=javaNumericCast(n.meta.x,values[n.ids.y]);
        else if(op==15u){
#ifdef GRID_INPUT
            // Normal new-chunk terrain has the vanilla no-blending pair (0,1).
            // Keep the general buffer-backed form for old/blended arbitrary
            // coordinate requests, but do not read a giant identical buffer
            // for the regular grid path.
            v=values[n.ids.y];
#else
            vec2 blend=blendInputs[sampleIndex];v=mix(double(blend.x),values[n.ids.y],double(blend.y));
#endif
        }
        else if(op==16u){double x=values[n.ids.y];v=(x>=double(n.params.x)&&x<double(n.params.y))?values[n.ids.z]:values[n.ids.w];}
        else if(op==17u){double rarity=double(spaghettiRarity(float(values[n.ids.y]),n.meta.x==0u?0u:1u));v=rarity*double(abs(normalNoise(p/float(rarity),uint(n.params.x))));}
        else if(op==18u){
            double x;
            double z;
            if(n.meta.x!=0u){
                x=(double(p.x)+values[n.ids.y])*double(n.params.y);
                z=(double(p.z)+values[n.ids.z])*double(n.params.y);
            } else {
                x=double(p.x)*double(n.params.y)+values[n.ids.y];
                z=double(p.z)*double(n.params.y)+values[n.ids.z];
            }
            v=double(normalNoise(vec3(float(x),0.0,float(z)),uint(n.params.x)))*double(n.params.z)+double(n.params.w);
        }
        else if(op==19u){v=1.0/values[n.ids.y];}
        values[n.meta.w]=v;
    }
    for (uint root = 0u; root < rootCount; root++) {
        results[sampleIndex * rootCount + root] = float(values[rootNodes[root]]);
    }
}
