#version 450
#extension GL_ARB_gpu_shader_fp64 : enable
layout(local_size_x = 64) in;

struct Node { uvec4 ids; vec4 params; uvec4 meta; };
struct SamplerInfo { uint octaveBase; uint octaveCount; float valueFactor; uint permutationBase; float firstInput; float firstValue; float secondInput; float secondValue; };
layout(std430,set=0,binding=0) readonly buffer Coordinates { vec4 coordinates[]; };
layout(std430,set=0,binding=1) writeonly buffer Results { float results[]; };
layout(std430,set=0,binding=2) readonly buffer Nodes { Node nodes[]; };
layout(std430,set=0,binding=3) readonly buffer Permutations { uint permutation[]; };
layout(std430,set=0,binding=4) readonly buffer Octaves { vec4 octaveData[]; };
layout(std430,set=0,binding=5) readonly buffer Samplers { SamplerInfo samplers[]; };
struct SplinePoint { float location; float derivative; uint valueNode; uint pad; };
layout(std430,set=0,binding=6) readonly buffer SplinePoints { SplinePoint splinePoints[]; };
struct PerlinInfo { uint octaveBase; uint octaveCount; float inputFactor; float valueFactor; uint permutationBase; uint pad0; uint pad1; uint pad2; };
// Keep this record exactly 192 bytes. Java packs three PerlinInfo records,
// explicit padding to align the dvec4, five doubles, and trailing padding.
// The vanilla BlendedNoise constants are doubles; keeping them as floats was
// the last material source of parity error in the full terrain graph.
struct BlendedInfo {
    PerlinInfo minLimit;
    PerlinInfo maxLimit;
    PerlinInfo main;
    uint align0; uint align1; uint align2; uint align3;
    dvec4 scales;
    double smearScale;
    uint pad0; uint pad1; uint pad2; uint pad3; uint pad4; uint pad5;
};
layout(std430,set=0,binding=7) readonly buffer BlendedMetadata { BlendedInfo blended[]; };
layout(std430,set=0,binding=8) readonly buffer BlendInputs { vec2 blendInputs[]; };
layout(std430,set=0,binding=9) readonly buffer Roots { uint rootNodes[]; };
layout(push_constant) uniform Parameters { uint count; uint nodeCount; uint rootCount; uint reserved; };

const vec3 G[16]=vec3[16](vec3(1,1,0),vec3(-1,1,0),vec3(1,-1,0),vec3(-1,-1,0),vec3(1,0,1),vec3(-1,0,1),vec3(1,0,-1),vec3(-1,0,-1),vec3(0,1,1),vec3(0,-1,1),vec3(0,1,-1),vec3(0,-1,-1),vec3(1,1,0),vec3(0,-1,1),vec3(-1,1,0),vec3(0,-1,-1));
uint perm(uint base,int i){return permutation[base+uint(i&255)];}
float fade(float v){return v*v*v*(v*(v*6-15)+10);}
// Matches Minecraft PerlinNoise.wrap exactly. Without this, terrain inputs
// diverge as soon as chunk coordinates become large enough for float phase
// precision to differ from Java's wrapped double coordinates.
float wrapNoise(float v){return v-floor(v/33554432.0+0.5)*33554432.0;}
vec3 wrapNoise(vec3 v){return vec3(wrapNoise(v.x),wrapNoise(v.y),wrapNoise(v.z));}
double wrapNoise64(double v){return v-floor(v/33554432.0+0.5)*33554432.0;}
dvec3 wrapNoise64(dvec3 v){return dvec3(wrapNoise64(v.x),wrapNoise64(v.y),wrapNoise64(v.z));}
float grad(uint base,int i,vec3 d){return dot(G[perm(base,i)&15u],d);}
float improved(vec3 pos,vec4 params,uint base){
    vec3 v=pos+params.xyz; ivec3 cell=ivec3(floor(v)); vec3 d=v-vec3(cell);
    uint a=perm(base,cell.x), b=perm(base,cell.x+1);
    uint a0=perm(base,int(a)+cell.y), a1=perm(base,int(a)+cell.y+1);
    uint b0=perm(base,int(b)+cell.y), b1=perm(base,int(b)+cell.y+1);
    float x=fade(d.x), y=fade(d.y), z=fade(d.z);
    float n0=grad(base,int(a0)+cell.z,d), n1=grad(base,int(b0)+cell.z,d-vec3(1,0,0));
    float n2=grad(base,int(a1)+cell.z,d-vec3(0,1,0)), n3=grad(base,int(b1)+cell.z,d-vec3(1,1,0));
    float n4=grad(base,int(a0)+cell.z+1,d-vec3(0,0,1)), n5=grad(base,int(b0)+cell.z+1,d-vec3(1,0,1));
    float n6=grad(base,int(a1)+cell.z+1,d-vec3(0,1,1)), n7=grad(base,int(b1)+cell.z+1,d-vec3(1,1,1));
    return mix(mix(mix(n0,n1,x),mix(n2,n3,x),y),mix(mix(n4,n5,x),mix(n6,n7,x),y),z);
}
float normalNoise(vec3 pos,uint id){
    SamplerInfo s=samplers[id]; float a=0, b=0;
    for(uint i=0;i<s.octaveCount;i++){ vec4 o=octaveData[(s.octaveBase+i)*2]; vec4 f=octaveData[(s.octaveBase+i)*2+1]; a+=o.w*improved(wrapNoise(pos*f.x),o,s.permutationBase+floatBitsToUint(f.z))*f.y; }
    for(uint i=0;i<s.octaveCount;i++){ vec4 o=octaveData[(s.octaveBase+s.octaveCount+i)*2]; vec4 f=octaveData[(s.octaveBase+s.octaveCount+i)*2+1]; b+=o.w*improved(wrapNoise(pos*1.0181269*f.x),o,s.permutationBase+floatBitsToUint(f.z))*f.y; }
    return (a+b)*s.valueFactor;
}
float improvedSmear(vec3 pos, vec4 params, uint base, float yScale, float yMax){
    vec3 v=pos+params.xyz; ivec3 cell=ivec3(floor(v)); vec3 d=v-vec3(cell);
    // Minecraft's ImprovedNoise.sampleAndLerp receives deltaY - d6, where
    // d6 is the quantized smear offset. The previous shader used d6 itself,
    // which changed every BlendedNoise branch using a non-zero Y smear.
    float weirdY=d.y;
    if(yScale!=0.0){float limit=(yMax>=0.0&&yMax<d.y)?yMax:d.y; weirdY=d.y-floor(limit/yScale+1e-7)*yScale;}
    uint a=perm(base,cell.x), b=perm(base,cell.x+1);
    uint a0=perm(base,int(a)+cell.y), a1=perm(base,int(a)+cell.y+1);
    uint b0=perm(base,int(b)+cell.y), b1=perm(base,int(b)+cell.y+1);
    float x=fade(d.x), y=fade(d.y), z=fade(d.z);
    float n0=grad(base,int(a0)+cell.z,vec3(d.x,weirdY,d.z)), n1=grad(base,int(b0)+cell.z,vec3(d.x-1,weirdY,d.z));
    float n2=grad(base,int(a1)+cell.z,vec3(d.x,weirdY-1,d.z)), n3=grad(base,int(b1)+cell.z,vec3(d.x-1,weirdY-1,d.z));
    float n4=grad(base,int(a0)+cell.z+1,vec3(d.x,weirdY,d.z-1)), n5=grad(base,int(b0)+cell.z+1,vec3(d.x-1,weirdY,d.z-1));
    float n6=grad(base,int(a1)+cell.z+1,vec3(d.x,weirdY-1,d.z-1)), n7=grad(base,int(b1)+cell.z+1,vec3(d.x-1,weirdY-1,d.z-1));
    return mix(mix(mix(n0,n1,x),mix(n2,n3,x),y),mix(mix(n4,n5,x),mix(n6,n7,x),y),z);
}
double fade64(double v){return v*v*v*(v*(v*6.0-15.0)+10.0);}
double grad64(uint base,int i,dvec3 d){return dot(dvec3(G[perm(base,i)&15u]),d);}
double improvedSmear64(dvec3 pos, vec4 params, uint base, double yScale, double yMax){
    dvec3 v=pos+dvec3(params.xyz); dvec3 cell=floor(v); dvec3 d=v-cell;
    double weirdY=d.y;
    if(yScale!=0.0){double limit=(yMax>=0.0&&yMax<d.y)?yMax:d.y; weirdY=d.y-floor(limit/yScale+1e-7)*yScale;}
    uint a=perm(base,int(cell.x)), b=perm(base,int(cell.x)+1);
    uint a0=perm(base,int(a)+int(cell.y)), a1=perm(base,int(a)+int(cell.y)+1);
    uint b0=perm(base,int(b)+int(cell.y)), b1=perm(base,int(b)+int(cell.y)+1);
    double x=fade64(d.x), y=fade64(d.y), z=fade64(d.z);
    double n0=grad64(base,int(a0)+int(cell.z),dvec3(d.x,weirdY,d.z)), n1=grad64(base,int(b0)+int(cell.z),dvec3(d.x-1.0,weirdY,d.z));
    double n2=grad64(base,int(a1)+int(cell.z),dvec3(d.x,weirdY-1.0,d.z)), n3=grad64(base,int(b1)+int(cell.z),dvec3(d.x-1.0,weirdY-1.0,d.z));
    double n4=grad64(base,int(a0)+int(cell.z)+1,dvec3(d.x,weirdY,d.z-1.0)), n5=grad64(base,int(b0)+int(cell.z)+1,dvec3(d.x-1.0,weirdY,d.z-1.0));
    double n6=grad64(base,int(a1)+int(cell.z)+1,dvec3(d.x,weirdY-1.0,d.z-1.0)), n7=grad64(base,int(b1)+int(cell.z)+1,dvec3(d.x-1.0,weirdY-1.0,d.z-1.0));
    double x0=mix(n0,n1,x), x1=mix(n2,n3,x), x2=mix(n4,n5,x), x3=mix(n6,n7,x);
    return mix(mix(x0,x1,y),mix(x2,x3,y),z);
}
double blendedOctave64(dvec3 pos, PerlinInfo info, uint octave, double yScale, double yMax){
    if (octave >= info.octaveCount) return 0.0;
    vec4 o=octaveData[(info.octaveBase+octave)*2u];
    vec4 f=octaveData[(info.octaveBase+octave)*2u+1u];
    // The uploader stores this flag with putInt(0/1) in the vec4 word.
    // Reading it as a float can flush bit-pattern 1 to zero on some GPUs.
    if(floatBitsToUint(f.w)==0u) return 0.0;
    // BlendedNoise's outer loop selects one getOctaveNoise(i) and divides
    // by that loop's frequency. The packed f.y stores that inverse factor.
    return double(o.w)*improvedSmear64(wrapNoise64(pos),o,floatBitsToUint(f.z),yScale,yMax)*double(f.y);
}
double blendedNoise64(vec3 p, uint id){
    BlendedInfo b=blended[id]; dvec3 pd=dvec3(p); double d0=0.0; double freq=1.0;
    dvec3 mainPos=dvec3(pd.x*b.scales.x/b.scales.z,pd.y*b.scales.y/b.scales.w,pd.z*b.scales.x/b.scales.z);
    double mainYScale=b.scales.y*b.smearScale/b.scales.w;
    for(uint i=0u;i<8u;i++){d0+=blendedOctave64(mainPos*freq,b.main,i,mainYScale*freq,pd.y*b.scales.y/b.scales.w*freq);freq*=0.5;}
    double t=(d0/10.0+1.0)/2.0; double minN=0.0; double maxN=0.0; freq=1.0;
    for(uint i=0u;i<16u;i++){
        dvec3 q=dvec3(pd.x*b.scales.x,pd.y*b.scales.y,pd.z*b.scales.x); double smear=b.scales.y*b.smearScale;
        if(t<1.0) minN+=blendedOctave64(q*freq,b.minLimit,i,smear*freq,pd.y*b.scales.y*freq);
        if(t>0.0) maxN+=blendedOctave64(q*freq,b.maxLimit,i,smear*freq,pd.y*b.scales.y*freq);
        freq*=0.5;
    }
    return clamp(minN/512.0+(maxN/512.0-minN/512.0)*clamp(t,0.0,1.0),-1e30,1e30)/128.0;
}
float spaghettiRarity(float x, uint mapper){
    if(mapper==1u){if(x < -0.75) return 0.5; if(x < -0.5) return 0.75; if(x < 0.5) return 1.0; return x < 0.75 ? 2.0 : 3.0;}
    if(x < -0.5) return 0.75; if(x < 0.0) return 1.0; return x < 0.5 ? 1.5 : 2.0;
}
double mapValue(double x,uint op){
    if(op==5u)return abs(x); if(op==6u)return x*x; if(op==7u)return x*x*x;
    if(op==8u)return x>0?x:x*.5; if(op==9u)return x>0?x:x*.25;
    if(op==10u){double v=clamp(x,-1.0,1.0);return v*.5-v*v*v/24.;} return x;
}
double splineValue(double coordinate, uint base, uint count, double values[1024]) {
    if (count == 0u) return 0.0;
    SplinePoint first = splinePoints[base];
    SplinePoint last = splinePoints[base + count - 1u];
    double firstValue = values[first.valueNode];
    double lastValue = values[last.valueNode];
    if (coordinate < first.location) return firstValue + first.derivative * (coordinate - first.location);
    if (coordinate >= last.location) return lastValue + last.derivative * (coordinate - last.location);
    uint interval = 0u;
    for (uint i = 0u; i + 1u < count; i++) {
        if (coordinate < splinePoints[base + i + 1u].location) { interval = i; break; }
    }
    SplinePoint a = splinePoints[base + interval];
    SplinePoint b = splinePoints[base + interval + 1u];
    double t = (coordinate - double(a.location)) / double(b.location - a.location);
    double va = values[a.valueNode];
    double vb = values[b.valueNode];
    double delta = vb - va;
    double c = double(a.derivative) * double(b.location - a.location) - delta;
    double d = -double(b.derivative) * double(b.location - a.location) + delta;
    return mix(va, vb, t) + t * (1.0 - t) * mix(c, d, t);
}
void main(){
    uint sampleIndex=gl_GlobalInvocationID.x; if(sampleIndex>=count)return;
    double values[1024]; vec3 p=coordinates[sampleIndex].xyz;
    for(uint i=0;i<nodeCount;i++){
        Node n=nodes[i]; uint op=n.ids.x; double v=0.0;
        if(op==1u)v=double(n.params.x);
        else if(op==2u)v=double(normalNoise(p*vec3(n.params.y,n.params.z,n.params.y),uint(n.params.x)));
        else if(op==3u){double x=values[n.ids.y],y=values[n.ids.z];if(n.meta.x==1u)v=x+y;else if(n.meta.x==2u)v=x==0.0?0.0:x*y;else if(n.meta.x==3u)v=min(x,y);else v=max(x,y);}
        else if(op==4u)v=n.meta.x==2u?values[n.ids.y]*double(n.params.z):values[n.ids.y]+double(n.params.z);
        else if(op==5u)v=clamp(values[n.ids.y],double(n.params.x),double(n.params.y));
        else if(op==6u)v=mapValue(values[n.ids.y],n.meta.x);
        else if(op==7u)v=values[n.ids.y];
        else if(op==8u)v=double(normalNoise(p*.25,uint(n.params.x)))*4.;
        else if(op==9u)v=double(normalNoise(vec3(p.x,0,p.z)*.25,uint(n.params.x)))*4.;
        else if(op==10u)v=double(normalNoise(vec3(p.z,p.x,0)*.25,uint(n.params.x)))*4.;
        else if(op==11u){vec3 q=vec3(p.x*n.params.x+float(values[n.ids.y]),p.y*n.params.y+float(values[n.ids.z]),p.z*n.params.x+float(values[n.ids.w]));v=double(normalNoise(q,uint(n.params.z)));}
        else if(op==12u){v=splineValue(values[n.ids.y],uint(n.params.x)*64u,uint(n.params.y),values);}
        else if(op==13u){v=blendedNoise64(p,uint(n.params.x));}
        else if(op==14u){double t=clamp((double(p.y)-double(n.params.x))/(double(n.params.y)-double(n.params.x)),0.0,1.0);v=mix(double(n.params.z),double(n.params.w),t);}
        else if(op==15u){vec2 blend=blendInputs[sampleIndex];v=mix(double(blend.x),values[n.ids.y],double(blend.y));}
        else if(op==16u){double x=values[n.ids.y];v=(x>=double(n.params.x)&&x<double(n.params.y))?values[n.ids.z]:values[n.ids.w];}
        else if(op==17u){double rarity=double(spaghettiRarity(float(values[n.ids.y]),n.meta.x==0u?0u:1u));v=rarity*double(abs(normalNoise(p/float(rarity),uint(n.params.x))));}
        values[i]=v;
    }
    for (uint root = 0u; root < rootCount; root++) {
        results[sampleIndex * rootCount + root] = float(values[rootNodes[root]]);
    }
}
