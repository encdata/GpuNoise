#version 450
layout(local_size_x = 64) in;

// Aquifer status staging keeps exact state IDs alongside broad fluid kinds so
// a later GPU substance stage can consume these rows without a Java readback.
struct InputRecord {
    int y;
    int defaultLevel;
    uint defaultKind;
    int defaultStateId;
    int lavaStateId;
    float floodedness;
    float spread;
    float lava;
    float erosion;
    float depth;
    float surfaceHeights[13];
    int globalLevels[13];
    uint globalKinds[13];
    int globalStateIds[13];
    int precomputed;
    int precomputedLevel;
    int precomputedStateId;
    uint precomputedKind;
};

layout(std430, set = 0, binding = 0) readonly buffer Inputs { uint words[]; };
layout(std430, set = 0, binding = 1) writeonly buffer Outputs { int values[]; };
layout(push_constant) uniform Parameters {
    uint count;
    uint baseByteOffset;
    uint outputBaseInt;
    uint compactPrecomputed;
};

const uint AIR = 0u;
const uint LAVA = 2u;
const uint FLAG_CPU_FALLBACK = 1u;
const uint FLAG_LAVA_OVERRIDE = 2u;
const uint FLAG_FALLBACK_ROOT_INPUT = 1u << 2u;
const uint FLAG_FALLBACK_SURFACE_INPUT = 1u << 3u;
const uint FLAG_FALLBACK_THRESHOLD = 1u << 4u;
const uint FLAG_FALLBACK_SPREAD_BOUNDARY = 1u << 5u;
const int LAVA_DISABLED_LEVEL = -32512;
const float EPSILON = 5.0e-3;

float clampValue(float value, float low, float high) {
    return max(low, min(high, value));
}

void emit(uint row, int level, int source, uint flags, int stateId, uint kind) {
    uint base = outputBaseInt + row * 5u;
    values[base] = level;
    values[base + 1u] = source;
    values[base + 2u] = int(flags);
    values[base + 3u] = stateId;
    values[base + 4u] = int(kind);
}

void fallback(uint row, uint reason) {
    emit(row, 0, 0, FLAG_CPU_FALLBACK | reason, 0, 3u);
}

InputRecord loadRecord(uint row) {
    InputRecord r;
    uint base = baseByteOffset / 4u;
    if (compactPrecomputed != 0u) {
        base += row * 4u;
        r.y = int(words[base]);
        r.precomputed = 1;
        r.precomputedLevel = int(words[base + 1u]);
        r.precomputedStateId = int(words[base + 2u]);
        r.precomputedKind = words[base + 3u];
        return r;
    }
    base += row * 66u;
    r.y = int(words[base]);
    r.defaultLevel = int(words[base + 1u]);
    r.defaultKind = words[base + 2u];
    r.defaultStateId = int(words[base + 3u]);
    r.lavaStateId = int(words[base + 4u]);
    r.floodedness = uintBitsToFloat(words[base + 5u]);
    r.spread = uintBitsToFloat(words[base + 6u]);
    r.lava = uintBitsToFloat(words[base + 7u]);
    r.erosion = uintBitsToFloat(words[base + 8u]);
    r.depth = uintBitsToFloat(words[base + 9u]);
    for (uint i = 0u; i < 13u; i++) {
        r.surfaceHeights[i] = uintBitsToFloat(words[base + 10u + i]);
        r.globalLevels[i] = int(words[base + 23u + i]);
        r.globalKinds[i] = words[base + 36u + i];
        r.globalStateIds[i] = int(words[base + 49u + i]);
    }
    r.precomputed = int(words[base + 62u]);
    r.precomputedLevel = int(words[base + 63u]);
    r.precomputedStateId = int(words[base + 64u]);
    r.precomputedKind = words[base + 65u];
    return r;
}

void main() {
    uint row = gl_GlobalInvocationID.x;
    if (row >= count) return;
    InputRecord r = loadRecord(row);
    if (r.precomputed != 0) {
        emit(row, r.precomputedLevel, 0, 0u, r.precomputedStateId, r.precomputedKind);
        return;
    }
    if (isnan(r.floodedness) || isinf(r.floodedness)
            || isnan(r.spread) || isinf(r.spread)
            || isnan(r.lava) || isinf(r.lava)
            || isnan(r.erosion) || isinf(r.erosion)
            || isnan(r.depth) || isinf(r.depth)) {
        fallback(row, FLAG_FALLBACK_ROOT_INPUT);
        return;
    }
    if (abs(r.erosion + 0.225) <= EPSILON || abs(r.depth - 0.9) <= EPSILON
            || abs(abs(r.lava) - 0.3) <= EPSILON) {
        fallback(row, FLAG_FALLBACK_THRESHOLD);
        return;
    }

    int surfaceEstimate = 2147483647;
    bool centerHasFluid = false;
    int minY = r.y - 12;
    int maxY = r.y + 12;
    for (int neighbor = 0; neighbor < 13; neighbor++) {
        float height = r.surfaceHeights[neighbor];
        if (isnan(height) || isinf(height)) {
            fallback(row, FLAG_FALLBACK_SURFACE_INPUT);
            return;
        }
        int surface = int(floor(height));
        int levelY = surface + 8;
        bool center = neighbor == 0;
        if (center && minY > levelY) {
            emit(row, r.defaultLevel, 0, 0u, r.defaultStateId, r.defaultKind);
            return;
        }
        bool aboveSurface = maxY > levelY;
        if (aboveSurface || center) {
            if (r.globalKinds[neighbor] != AIR) {
                if (center) centerHasFluid = true;
                if (aboveSurface) {
                    emit(row, r.globalLevels[neighbor], neighbor + 1, 0u,
                            r.globalStateIds[neighbor], r.globalKinds[neighbor]);
                    return;
                }
            }
        }
        surfaceEstimate = min(surfaceEstimate, surface);
    }

    float density;
    float levelDensity;
    if (r.erosion < -0.225 && r.depth > 0.9) {
        density = -1.0;
        levelDensity = -1.0;
    } else {
        int delta = surfaceEstimate + 8 - r.y;
        float fade = centerHasFluid ? clampValue(1.0 - float(delta) / 64.0, 0.0, 1.0) : 0.0;
        float floodedness = clampValue(r.floodedness, -1.0, 1.0);
        density = floodedness + 0.8 + (fade - 1.0) * 1.2;
        levelDensity = floodedness + 0.3 + (fade - 1.0) * 1.1;
    }
    if (abs(density) <= EPSILON || abs(levelDensity) <= EPSILON) {
        fallback(row, FLAG_FALLBACK_THRESHOLD);
        return;
    }

    int fluidLevel;
    if (levelDensity > 0.0) {
        fluidLevel = r.defaultLevel;
    } else if (density > 0.0) {
        float scaledSpread = r.spread * 10.0;
        float spreadIndex = scaledSpread / 3.0;
        if (abs(spreadIndex - roundEven(spreadIndex)) <= EPSILON) {
            fallback(row, FLAG_FALLBACK_SPREAD_BOUNDARY);
            return;
        }
        int base = (r.y / 40) * 40 + 20;
        if (r.y < 0 && r.y % 40 != 0) base -= 40;
        int spreadOffset = int(floor(spreadIndex)) * 3;
        fluidLevel = min(surfaceEstimate, base + spreadOffset);
    } else {
        fluidLevel = LAVA_DISABLED_LEVEL;
    }

    if (fluidLevel <= -10 && fluidLevel != LAVA_DISABLED_LEVEL
            && r.defaultKind != LAVA && abs(r.lava) > 0.3) {
        emit(row, fluidLevel, 0, FLAG_LAVA_OVERRIDE, r.lavaStateId, LAVA);
        return;
    }
    emit(row, fluidLevel, 0, 0u, r.defaultStateId, r.defaultKind);
}
