#version 450
layout(local_size_x = 64) in;

layout(std430, set = 0, binding = 0) readonly buffer GridRoots { float values[]; };
// One result per 4-block quart column, in chunk-major Z/X order. Minecraft's
// NoiseChunk snaps preliminary surface coordinates to this same grid. INT_MIN requests the
// existing Java scan when a value is non-finite or too close to its threshold.
layout(std430, set = 0, binding = 1) writeonly buffer SurfaceHeights { int heights[]; };
layout(std430, set = 0, binding = 2) readonly buffer ChunkMetadata { uint metadata[]; };
layout(push_constant) uniform Parameters {
    uint chunkCount;
    uint samplesPerChunk;
    uint rootStride;
    uint initialDensityRoot;
    float threshold;
    float parityEpsilon;
    uint reserved0;
    uint reserved1;
};

void main() {
    uint columnIndex = gl_GlobalInvocationID.x;
    if (columnIndex >= chunkCount * 16u) return;

    uint chunk = columnIndex / 16u;
    uint quartColumn = columnIndex % 16u;
    uint cellX = quartColumn % 4u;
    uint cellZ = quartColumn / 4u;
    uint metadataBase = chunk * 12u;
    int minY = int(metadata[metadataBase + 9u]);
    uint cornerOffset = metadata[metadataBase + 0u];
    uint cellsX = metadata[metadataBase + 2u];
    uint cellsY = metadata[metadataBase + 3u];
    uint cellsZ = metadata[metadataBase + 4u];
    uint cellHeight = metadata[metadataBase + 6u];
    uint gridX = cellsX + 1u;
    uint gridZ = cellsZ + 1u;
    // NoiseChunk samples the raw graph on cell-height boundaries, starting at
    // the top boundary and including the minimum-Y boundary.
    int surface = 2147483647;

    for (uint cellY = cellsY; ; --cellY) {
        uint sampleIndex = cornerOffset + (cellY * gridX + cellX) * gridZ + cellZ;
        if (sampleIndex >= chunkCount * samplesPerChunk) {
            heights[columnIndex] = int(0x80000000u);
            return;
        }
        float density = values[sampleIndex * rootStride + initialDensityRoot];
        if (isnan(density) || isinf(density) || abs(density - threshold) <= parityEpsilon) {
            heights[columnIndex] = int(0x80000000u);
            return;
        }
        if (density > threshold) {
            surface = minY + int(cellY * cellHeight);
            break;
        }
        if (cellY == 0u) break;
    }
    heights[columnIndex] = surface;
}
