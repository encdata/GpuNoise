#version 450
layout(local_size_x = 64) in;

struct Selection {
    int first;
    int second;
    int third;
    int fourth;
    int firstDistance;
    int secondDistance;
    int thirdDistance;
    int fourthDistance;
};

layout(std430, set = 0, binding = 0) readonly buffer Queries { uint words[]; };
layout(std430, set = 0, binding = 1) writeonly buffer Selections { Selection values[]; };
layout(push_constant) uniform Parameters { uint count; };

void emitInvalid(uint queryIndex) {
    values[queryIndex].first = -1;
    values[queryIndex].second = -1;
    values[queryIndex].third = -1;
    values[queryIndex].fourth = -1;
    values[queryIndex].firstDistance = -1;
    values[queryIndex].secondDistance = -1;
    values[queryIndex].thirdDistance = -1;
    values[queryIndex].fourthDistance = -1;
}

void main() {
    uint queryIndex = gl_GlobalInvocationID.x;
    if (queryIndex >= count) return;
    if (words[0] != count) {
        emitInvalid(queryIndex);
        return;
    }
    uint groupCount = words[1];
    uint queryBase = 2u + queryIndex * 4u;
    uint centerGroup = words[queryBase + 3u];
    if (centerGroup >= groupCount) {
        emitInvalid(queryIndex);
        return;
    }
    ivec3 point = ivec3(int(words[queryBase]), int(words[queryBase + 1u]),
            int(words[queryBase + 2u]));
    uint centerBase = 2u + count * 4u + centerGroup * 48u;
    int indices[4] = int[4](-1, -1, -1, -1);
    int distances[4] = int[4](2147483647, 2147483647, 2147483647, 2147483647);
    for (int i = 0; i < 12; i++) {
        uint base = centerBase + uint(i) * 4u;
        ivec3 center = ivec3(int(words[base]), int(words[base + 1u]), int(words[base + 2u]));
        ivec3 delta = center - point;
        int distance = delta.x * delta.x + delta.y * delta.y + delta.z * delta.z;
        // NoiseBasedAquifer uses inclusive comparisons for all three ranks.
        if (distances[0] >= distance) {
            indices[3] = indices[2]; distances[3] = distances[2];
            indices[2] = indices[1]; distances[2] = distances[1];
            indices[1] = indices[0]; distances[1] = distances[0];
            indices[0] = i; distances[0] = distance;
        } else if (distances[1] >= distance) {
            indices[3] = indices[2]; distances[3] = distances[2];
            indices[2] = indices[1]; distances[2] = distances[1];
            indices[1] = i; distances[1] = distance;
        } else if (distances[2] >= distance) {
            indices[3] = indices[2]; distances[3] = distances[2];
            indices[2] = i; distances[2] = distance;
        } else if (distances[3] >= distance) {
            indices[3] = i; distances[3] = distance;
        }
    }

    values[queryIndex].first = indices[0];
    values[queryIndex].second = indices[1];
    values[queryIndex].third = indices[2];
    values[queryIndex].fourth = indices[3];
    values[queryIndex].firstDistance = distances[0];
    values[queryIndex].secondDistance = distances[1];
    values[queryIndex].thirdDistance = distances[2];
    values[queryIndex].fourthDistance = distances[3];
}
