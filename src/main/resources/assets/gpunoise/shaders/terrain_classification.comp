#version 450
layout(local_size_x = 64) in;

// Compact IDs are resolved by the CPU-side registry table after readback.
// 0 = air, 1 = default solid, 2 = default fluid, 3 = lava.
layout(std430,set=0,binding=0) readonly buffer Density { float density[]; };
layout(std430,set=0,binding=1) readonly buffer Aquifer { vec4 aquifer[]; };
layout(std430,set=0,binding=2) writeonly buffer BlockIds { uint blockIds[]; };
layout(push_constant) uniform Parameters {
    uint count;
    float solidThreshold;
    float fluidThreshold;
    float lavaThreshold;
};

void main(){
    uint i=gl_GlobalInvocationID.x;
    if(i>=count)return;
    float d=density[i];
    vec4 a=aquifer[i];
    if(d>solidThreshold){ blockIds[i]=1u; return; }
    if(a.x>lavaThreshold){ blockIds[i]=3u; return; }
    if(a.x>fluidThreshold && d<0.0){ blockIds[i]=2u; return; }
    blockIds[i]=0u;
}
